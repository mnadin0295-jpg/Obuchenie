import pandas as pd

# Пути к вашим файлам
path_movies = r'C:\Users\user\Desktop\Надя\панда задание 2\1\movies.csv'
path_ratings = r'C:\Users\user\Desktop\Надя\панда задание 2\1\ratings.csv'

def classify_rating(rating):
    if rating <= 2:
        return 'низкий рейтинг'
    elif rating <= 4:
        return 'средний рейтинг'
    elif rating >= 4.5:
        return 'высокий рейтинг'
    else:
        return 'не классифицирован'

def main():
    # загрузка данных
    ratings_df = pd.read_csv(path_ratings)
    # добавляем столбец class
    ratings_df['class'] = ratings_df['rating'].apply(classify_rating)
    # сохраняем результат
    ratings_df.to_csv(r'C:\Users\user\Desktop\Надя\панда задание 2\1\rated_movies_with_class.csv', index=False)
    print("Классификация завершена, файл сохранён.")

if __name__ == '__main__':
    main()
